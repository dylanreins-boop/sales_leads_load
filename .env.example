# Copy to .env and fill in.
PORT=3000

# ---- Company ----
BRAND_NAME=Bob Moses Ceramic Coating
# Name under the icon when installed on a phone (keep it short).
BRAND_SHORT_NAME=Bob Moses Leads
BRAND_CITY=Las Vegas
# Used in the default follow-up email. From bobmosescc.com/locations/las-vegas-nv
# (call or text, 6 AM - 2:30 PM Monday - Friday).
BRAND_PHONE=(702) 600-1128
BRAND_ADDRESS=3120 W Sirius Ave Ste 103, Las Vegas, NV 89102
BRAND_WEBSITE=https://bobmosescc.com/locations/las-vegas-nv/
# Las Vegas time, so "call tomorrow at 9 AM" means 9 AM Pacific.
TZ=America/Los_Angeles
# The shop is closed weekends: Friday call-backs land on Monday. Set to false to allow weekends.
REMINDER_SKIP_WEEKENDS=true
# Leads move to "Old & Dead Leads" this many days after they came in (Booked leads stay on the board).
LEAD_ARCHIVE_DAYS=14
# Where the SQLite database lives. Job photos go in a "photos" folder next to it
# unless PHOTOS_DIR is set.
# DB_PATH=./data/leads.db
# PHOTOS_DIR=./data/photos

# Dashboard logins (strongly recommended once the app is on the internet).
# One "Name:password" per person, comma-separated. The name shows next to
# everything that person does (notes, call outcomes, stage moves, checklist ticks, photos).
# End each login with its level:
#   :admin  sees everything, plus the Updates feed of every change, Excel export and settings
#   :sales  the lead pipelines only: work leads, log calls, book jobs
#   :shop   the job calendar only
# A login with no level is sales.
APP_USERS=Dylan:change-me:admin,Sam:change-me-too:sales,Mike:change-me-three:shop
# Or a single shared login (an admin):
# APP_USER=admin
# APP_PASSWORD=change-me

# Hour (0-23) used for "call tomorrow" reminders if the browser doesn't supply one.
REMINDER_HOUR=9

# ---- Website form ----
# Optional shared secret. Send it as an X-API-Key header (server-to-server)
# or an api_key form field.
WEBSITE_API_KEY=
# Comma-separated list of sites allowed to post the form from the browser.
CORS_ORIGINS=https://www.yourcompany.com

# ---- Email (voicemail follow-up emails) ----
# One of: resend, sendgrid, postmark
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Must be an address/domain you've verified with the email service.
EMAIL_FROM=Your Company <office@yourcompany.com>
# Where lead replies go (optional).
EMAIL_REPLY_TO=

# ---- Facebook Lead Ads ----
# Any random string; paste the same value into the Meta webhook setup.
FB_VERIFY_TOKEN=
# Meta app > Settings > Basic > App secret (used to verify webhook signatures).
FB_APP_SECRET=
# Long-lived Page access token with leads_retrieval permission.
FB_PAGE_ACCESS_TOKEN=
# Comma-separated lead form IDs for the "Sync Facebook" button.
FB_FORM_IDS=
FB_GRAPH_VERSION=v23.0
