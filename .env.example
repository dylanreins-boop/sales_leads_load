# Copy to .env and fill in.
PORT=3000

# ---- Company ----
BRAND_NAME=Bob Moses Ceramic Coating
# Name under the icon when installed on a phone (keep it short).
BRAND_SHORT_NAME=Bob Moses Leads
BRAND_CITY=Las Vegas
# Used in the default follow-up email. From bobmosescc.com/locations/las-vegas-nv
# (call or text, 6 AM - 2:30 PM Monday - Friday).
BRAND_PHONE=(702) 600-1128
BRAND_ADDRESS=3120 W Sirius Ave Ste 103, Las Vegas, NV 89102
BRAND_WEBSITE=https://bobmosescc.com/locations/las-vegas-nv/
# Las Vegas time, so "call tomorrow at 9 AM" means 9 AM Pacific.
TZ=America/Los_Angeles
# The shop is closed weekends: Friday call-backs land on Monday. Set to false to allow weekends.
REMINDER_SKIP_WEEKENDS=true
# Leads move to "Old & Dead Leads" this many days after they came in (Booked leads stay on the board).
LEAD_ARCHIVE_DAYS=14
# Where the SQLite database lives. Job photos go in a "photos" folder next to it
# unless PHOTOS_DIR is set.
# DB_PATH=./data/leads.db
# PHOTOS_DIR=./data/photos

# First admin login: on the live server (NODE_ENV=production) with no logins set, the sign-in page asks
# for the first admin's name and password. Set SETUP_CODE so only someone who knows it can do that.
# SETUP_CODE=pick-something-only-you-know
# On your own computer with no logins, the app is open (everyone an admin) for trying it out.
# Dashboard logins (strongly recommended once the app is on the internet).
# One "Name:password" per person, comma-separated. The name shows next to
# everything that person does (notes, call outcomes, stage moves, checklist ticks, photos).
# End each login with its level:
#   :admin  sees everything, plus the Updates feed of every change, Excel export and settings
#   :sales  the lead pipelines only: work leads, log calls, book jobs
#   :shop   the job calendar only
# A login with no level is sales.
# Admins add everyone else from the Team panel in the app.
APP_USERS=Dylan:change-me:admin
# Or a single shared login (an admin):
# APP_USER=admin
# APP_PASSWORD=change-me

# Hour (0-23) used for "call tomorrow" reminders if the browser doesn't supply one.
REMINDER_HOUR=9

# ---- Website form ----
# Required on the live server (NODE_ENV=production): without it the form is off. Send it as an
# X-API-Key header (server-to-server) or an api_key form field. Any long random string.
WEBSITE_API_KEY=
# Sites allowed to post the form from a browser, comma-separated. On the live server it defaults to
# BRAND_WEBSITE and its www. address.
# CORS_ORIGINS=https://bobmosescc.com,https://www.bobmosescc.com

# ---- Email (voicemail follow-up emails) ----
# One of: resend, sendgrid, postmark
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Must be an address/domain you've verified with the email service.
EMAIL_FROM=Your Company <office@yourcompany.com>
# Where lead replies go (optional).
EMAIL_REPLY_TO=

# ---- Facebook Lead Ads ----
# Any random string; paste the same value into the Meta webhook setup.
FB_VERIFY_TOKEN=
# Meta app > Settings > Basic > App secret (used to verify webhook signatures).
FB_APP_SECRET=
# Long-lived Page access token with leads_retrieval permission.
FB_PAGE_ACCESS_TOKEN=
# Comma-separated lead form IDs for the "Sync Facebook" button.
FB_FORM_IDS=
FB_GRAPH_VERSION=v23.0

# Past customers show as "Due for maintenance" this many months after pick-up.
# RECOAT_MONTHS=11

# ---- Social media posts (Facebook, Instagram, TikTok, YouTube Shorts) ----
# Admins approve each post in the app's Social panel; nothing posts on its own. See README "Social media posts".
# Facebook Page ID. Uses FB_PAGE_ACCESS_TOKEN above, which also needs pages_manage_posts.
# FB_PAGE_ID=
# Instagram professional account ID linked to the Page (needs instagram_content_publish).
# IG_USER_ID=
# TikTok Content Posting API (developers.tiktok.com). Posts stay private until TikTok approves the app.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REFRESH_TOKEN=
# YouTube Data API (Google Cloud OAuth client). Uploads stay private until Google verifies the app.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# ---- The app's address ----
# Used in booking links sent to customers, to check Twilio's signatures, and for social media photos
# (Facebook, Instagram and TikTok fetch the photos from this address, so it must be public HTTPS).
PUBLIC_URL=https://leads.yourcompany.com

# ---- Text messages (Twilio) ----
# Texting from leads, booking confirmations, day-before reminders and alert texts.
# Twilio console > Account info. TWILIO_FROM is your Twilio number (or use a Messaging Service).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+17025550000
# TWILIO_MESSAGING_SERVICE_SID=
# In Twilio, set the number's "A message comes in" webhook to https://<your app>/webhooks/twilio
# and "A call comes in" to https://<your app>/webhooks/twilio/voice (missed-call text-back).
# Calls ring through to this phone first; if nobody answers, the caller gets a text.
FORWARD_CALLS_TO=

# ---- New-lead alerts ----
# Alert the admins when nobody has worked a new lead within this many minutes.
# SPEED_TO_LEAD_MINUTES=15
# Alerts only go out between these hours (overnight leads are alerted in the morning).
# ALERT_HOURS=7-20

# ---- Google Local Services leads (Google Ads API) ----
# Leave blank to skip. See "Google Local Services leads" in the README.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v25

# ---- The dialer (the build with the dialer) ----
# Turn on to get the dialer: calls from the app with live call notes. Off = the build without it.
# CALLS_ENABLED=1
# Claude writes the call notes with this key (without it, basic notes are written).
# ANTHROPIC_API_KEY=
# What the customer hears before they're connected, and the hours calls can go out.
# CALL_NOTICE=Hi, this call may be transcribed for quality. Connecting you now.
# CALL_HOURS=8-21
